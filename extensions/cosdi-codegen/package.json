{
  "package_version": 2,
  "version": "1.0.0",
  "name": "cosdi-codegen",
  "title": "CosDI Codegen",
  "description": "Writes the runtime token for every interface tagged @generateToken, outside the assets folder",
  "author": "vvda12061999",
  "license": "MIT",
  "homepage": "https://github.com/vvda12061999/CosDI",
  "bugs": {
    "url": "https://github.com/vvda12061999/CosDI/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vvda12061999/CosDI.git",
    "directory": "extensions/cosdi-codegen"
  },
  "keywords": [
    "cocos",
    "cocos-creator",
    "cocos-creator-extension",
    "di",
    "dependency-injection",
    "codegen",
    "cosdi"
  ],
  "peerDependencies": {
    "cosdi": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "cosdi": {
      "optional": true
    }
  },
  "bin": {
    "cosdi-codegen": "./bin/cosdi-codegen.js"
  },
  "scripts": {
    "postinstall": "node ./bin/cosdi-codegen.js install --from-postinstall"
  },
  "files": [
    "bin",
    "lib",
    "main.js",
    "package.json",
    "LICENSE",
    "README.md"
  ],
  "editor": ">=3.0.0",
  "main": "./main.js",
  "contributions": {
    "menu": [
      {
        "path": "CosDI",
        "label": "Generate Interface Tokens",
        "message": "generate-tokens"
      }
    ],
    "messages": {
      "generate-tokens": {
        "methods": ["generateTokens"]
      },
      "asset-db:asset-add": {
        "methods": ["onAssetChange"]
      },
      "asset-db:asset-change": {
        "methods": ["onAssetChange"]
      },
      "asset-db:asset-changed": {
        "methods": ["onAssetChange"]
      },
      "asset-db:ready": {
        "methods": ["onAssetDbReady"]
      }
    }
  }
}
