{
  "package_version": 2,
  "version": "1.0.0",
  "name": "cosdi",
  "title": "CosDI",
  "description": "CosDI diagnostics panel",
  "author": "CosDI",
  "editor": ">=3.8.0",
  "main": "./main.js",
    "panels": {
      "default": {
        "title": "CosDI Diagnostics",
        "type": "dockable",
        "main": "./panels/default.js",
        "flags": {
          "resizable": true,
          "save": true,
          "alwaysOnTop": false
        },
        "size": {
          "min-width": 320,
          "min-height": 150,
          "width": 520,
          "height": 360
        }
      },
      "diagnostics": {
        "title": "CosDI Diagnostics",
        "type": "dockable",
        "main": "./panels/diagnostics.js",
        "flags": {
          "resizable": true,
          "save": true,
          "alwaysOnTop": false
        },
        "size": {
          "min-width": 320,
          "min-height": 150,
          "width": 520,
          "height": 360
        }
      }
    },
  "contributions": {
    "menu": [
      {
        "path": "i18n:menu.panel",
        "label": "CosDI Diagnostics",
        "message": "open-panel"
      },
      {
        "path": "i18n:menu.extension",
        "label": "CosDI Diagnostics",
        "message": "open-panel"
      },
      {
        "path": "CosDI",
        "label": "Diagnostics",
        "message": "open-panel"
      }
    ],
    "messages": {
      "open-panel": {
        "methods": ["openPanel"]
      },
      "get-snapshot": {
        "methods": ["getSnapshot"]
      }
    },
    "scene": {
      "script": "./scene.js"
    }
  }
}
