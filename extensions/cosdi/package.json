{
  "package_version": 2,
  "version": "1.0.0",
  "name": "cosdi",
  "title": "CosDI",
  "description": "VContainer-style dependency injection for Cocos Creator 3.x",
  "author": "vvda12061999",
  "license": "MIT",
  "homepage": "https://github.com/vvda12061999/CosDI",
  "bugs": {
    "url": "https://github.com/vvda12061999/CosDI/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vvda12061999/CosDI.git",
    "directory": "extensions/cosdi"
  },
  "keywords": [
    "cocos",
    "cocos-creator",
    "di",
    "dependency-injection",
    "vcontainer"
  ],
  "bin": {
    "cosdi": "./bin/cosdi.js"
  },
  "files": [
    "bin",
    "i18n",
    "lib",
    "main.js",
    "package.json",
    "panels",
    "runtime",
    "scene.js",
    "static",
    "LICENSE",
    "README.md"
  ],
  "editor": ">=3.0.0",
  "main": "./main.js",
  "panels": {
    "default": {
      "title": "CosDI Diagnostics",
      "type": "dockable",
      "main": "./panels/default.js",
      "icon": "./static/icon.png",
      "flags": {
        "resizable": true,
        "save": true,
        "alwaysOnTop": false
      },
      "size": {
        "min-width": 320,
        "min-height": 150,
        "width": 520,
        "height": 360
      }
    }
  },
  "contributions": {
    "menu": [
      {
        "path": "i18n:menu.panel",
        "label": "CosDI Diagnostics",
        "message": "open-panel"
      },
      {
        "path": "CosDI",
        "label": "Diagnostics",
        "message": "open-panel"
      },
      {
        "path": "CosDI",
        "label": "Generate Interface Tokens",
        "message": "generate-tokens"
      },
      {
        "path": "CosDI",
        "label": "Install Runtime into Project",
        "message": "install-runtime"
      }
    ],
    "messages": {
      "open-panel": {
        "methods": ["openPanel"]
      },
      "get-snapshot": {
        "methods": ["getSnapshot"]
      },
      "install-runtime": {
        "methods": ["installRuntime"]
      },
      "generate-tokens": {
        "methods": ["generateTokens"]
      },
      "asset-db:asset-add": {
        "methods": ["onAssetChange"]
      },
      "asset-db:asset-change": {
        "methods": ["onAssetChange"]
      }
    },
    "scene": {
      "script": "./scene.js"
    }
  }
}
